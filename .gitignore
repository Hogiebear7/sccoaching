# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the secretless template is part of the repo docs
!.env.local.example

# vercel
.vercel

# local JSON data store
/data

# exercise-library import staging (source packs/media — not checked in),
# but keep the README documenting the expected directory shape.
/import-data/*
!/import-data/README.md

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright transient output (baselines in e2e/*-snapshots ARE tracked)
/test-results
/playwright-report
