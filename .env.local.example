# Used to HMAC-sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Absolute path to store data/db.json in. Leave unset locally (defaults to
# ./data inside the project). REQUIRED in production on any host that
# replaces the whole code directory on each deploy (e.g. Hostinger's
# .builds/versions/<id> layout) — point this at a folder OUTSIDE that
# deploy-managed tree, or every deploy wipes all member/booking/etc. data.
#
# If your host caps the number of environment variables (observed: 3 on
# Hostinger's free plan), set SANDC_APP_CONFIG instead: one variable packing
# several values as key=value pairs separated by "|" (no quotes, no JSON —
# see lib/app-config.ts). Supported keys: sessionSecret, dataDir, appUrl,
# anthropicApiKey, stripeSecretKey, stripeWebhookSecret, resendApiKey,
# emailFrom, contactNotifyEmail, supabaseServiceRoleKey. Example:
#   SANDC_APP_CONFIG=sessionSecret=...|dataDir=/home/.../sandc-data|appUrl=https://sandccoaching.com
# (The name is not APP_CONFIG: Hostinger silently drops a variable with that
# name.) Standalone variables always take priority when set.
DATA_DIR=

# Supabase (Postgres backend). Both values are public/client-safe (the
# publishable key is designed to be exposed — access control is enforced by
# Postgres Row Level Security policies, not by keeping this secret). Get
# these from Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase SERVICE ROLE key — a genuine secret, never NEXT_PUBLIC_, never
# sent to the browser. Bypasses Row Level Security entirely, so only
# server-side code that has already done its own auth check may use it (see
# lib/exercise-library/admin-client.ts). Required for the exercise library
# feature (import pipeline + staff/member API routes) — everything else in
# the app works fine without it. Get it from Project Settings > API >
# service_role secret in the Supabase dashboard.
# On a host with a capped env var count (see DATA_DIR note above), add
# supabaseServiceRoleKey=... to SANDC_APP_CONFIG instead of setting this standalone.
SUPABASE_SERVICE_ROLE_KEY=

# Revolut Merchant API (membership billing). Leave unset to keep billing in
# its honest "not configured" state — selecting a plan only records intent,
# no charge occurs. See docs/billing-revolut.md for full setup steps.
REVOLUT_SECRET_KEY=
REVOLUT_WEBHOOK_SIGNING_SECRET=
REVOLUT_ENV=sandbox
REVOLUT_API_VERSION=2024-09-01
REVOLUT_CURRENCY=EUR

# How many hours before a class starts a cancellation still restores the
# member's session credit. Defaults to 12 if unset.
CANCELLATION_CUTOFF_HOURS=12

# Authorizes external schedulers to trigger background housekeeping jobs at
# POST/GET /api/cron/run (sent as `Authorization: Bearer <value>`). Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset locally — staff can still trigger a run manually from the
# Staff Operations page using their own session. See docs/scheduler.md.
CRON_SECRET=

# Web Push (VAPID). Generate a key pair once with:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY and NEXT_PUBLIC_VAPID_PUBLIC_KEY must be the same value.
# The NEXT_PUBLIC_ prefix exposes the key to client-side code (Phase 3 subscribe flow).
# Leave all three unset locally — push will fall back to console.log.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
#
# PUSH_ENABLED — operational kill-switch for all push sends. Set to "false" to
# suppress every sendPush() call without removing VAPID keys or redeploying.
# Omit or set to any other value to leave push enabled (subject to VAPID config).
# PUSH_ENABLED=false

# Outbound email via Resend (https://resend.com). Leave unset locally — email
# falls back to console.log so all other flows work without an API key.
# On a host with a capped env var count (see DATA_DIR note above), add
# resendApiKey=... / emailFrom=... / contactNotifyEmail=... to SANDC_APP_CONFIG
# instead of the standalone vars below.
#
# Production setup:
#   1. Add and verify your domain in the Resend dashboard (adds SPF/DKIM DNS records).
#   2. Create a production API key scoped to "Sending access".
#   3. Set EMAIL_FROM to a verified sender using the display-name format below.
#   4. Set APP_URL to your public domain so email action links resolve correctly.
#
# RESEND_API_KEY — leave blank locally (enables console fallback).
RESEND_API_KEY=
#
# EMAIL_FROM — sandbox address below works for local dev with Resend's shared domain.
# In production replace with a verified sender: "S&C Performance Coaching <info@sandccoaching.com>"
# Using onboarding@resend.dev in production will be rejected by the Resend API.
EMAIL_FROM=onboarding@resend.dev
#
# APP_URL — the public origin, e.g. https://sandccoaching.com (no trailing
# path). Used for email action links, Stripe checkout success/cancel
# redirects, canonical URLs, the social preview, robots.txt and sitemap.xml
# (lib/site-url.ts). Must be set in production, and BEFORE the build runs:
# canonical/social metadata on static pages is rendered at build time. If unset, both fall
# back to http://localhost:3000 — an outage discovered once when logout hit
# this on Hostinger's reverse proxy, and again when Stripe checkout used a
# second, never-actually-configured APP_BASE_URL var for the same purpose.
# On a host with a capped env var count (see DATA_DIR note above), add
# appUrl=... to SANDC_APP_CONFIG instead of setting this standalone.
APP_URL=http://localhost:3000
#
# CONTACT_NOTIFY_EMAIL — where public website contact-form leads are sent.
# Replace with the real inbox that should receive enquiries. Each notification
# has Reply-To set to the enquirer, so replying answers them directly.
# Enquiries are also stored in the Supabase table contact_inquiries, so
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY are required
# for the contact form to work at all.
CONTACT_NOTIFY_EMAIL=info@sandccoaching.com

# Stripe (primary payment provider). In production use LIVE keys from a
# separate Stripe workspace/dashboard mode — never reuse test keys.
# On a host with a capped env var count (see DATA_DIR note above), add
# stripeSecretKey=... / stripeWebhookSecret=... to SANDC_APP_CONFIG instead.
STRIPE_SECRET_KEY=
# Signing secret of the PRODUCTION webhook endpoint (whsec_...), created in
# the Stripe dashboard — the CLI listener secret is local-only.
STRIPE_WEBHOOK_SECRET=
# STRIPE_CURRENCY=eur

# AI coach (Workout Helper / coach summaries). Rotate before launch if the
# development key may have been exposed. Leave unset to disable AI features.
# On a host with a capped env var count (see DATA_DIR note above), add
# anthropicApiKey=... to SANDC_APP_CONFIG instead of setting this standalone.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Food catalog: Open Food Facts live-write submission (see docs/food-catalog.md
# "Open Food Facts write-prep"). The read-side barcode/branded-food lookup
# (lib/open-food-facts-client.ts's lookupOpenFoodFactsByBarcode) is always on
# and needs no config — this section is ONLY for actually publishing a
# member's approved custom-food submission back to Open Food Facts.
#
# OFF_LIVE_WRITE_ENABLED — kill-switch/enable-switch for live OFF writes.
# Leave unset (or "false") to keep submissions stopping at "approved" after
# staff review, which is the correct/safe state until a real provider exists.
# Setting this to "true" alone does NOT enable live writes — it also requires
# a real OffSubmissionProvider to be implemented and swapped in for the
# `offSubmissionProvider` export in lib/open-food-facts-client.ts (Open Food
# Facts' write API needs producer/org credentials this repo doesn't have).
# Setting the flag without the provider is logged as a warning on first use
# and has no other effect — the flag can never accidentally enable a live
# external write on its own.
OFF_LIVE_WRITE_ENABLED=false
#
# Food photo scanning (label reading + food identification) reuses the same
# ANTHROPIC_API_KEY as every other AI feature — see lib/ai.ts's
# identifyFoodPhoto. No separate OCR vendor/env var needed.

# Google Play Billing (Tier 2 "App Subscription" purchase, Android only).
# Leave all unset to keep isGooglePlayConfigured() false — the purchase-verify
# route responds 503 and the mobile app's paywall should treat that as
# "not available right now" rather than erroring loudly. These are secrets
# too, so — like REVOLUT_SECRET_KEY — kept standalone-only, never packed into
# SANDC_APP_CONFIG. See lib/providers/google-play.ts.
#
# GOOGLE_PLAY_PACKAGE_NAME — the app's Android application id, e.g.
# "com.sandcperformancecoaching.app" (must match app.json's android.package).
GOOGLE_PLAY_PACKAGE_NAME=
#
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64 — base64 of the FULL service-account
# JSON key file downloaded from Google Cloud Console (IAM & Admin > Service
# Accounts), for a service account linked in Play Console (Setup > API access)
# with at least "View app information" + "Manage orders and subscriptions"
# permission. Generate the base64 with:
#   node -e "console.log(require('fs').readFileSync('service-account.json').toString('base64'))"
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=
#
# GOOGLE_PLAY_SUBSCRIPTION_PRODUCT_ID — the subscription product id created
# in Play Console (Monetize > Subscriptions). That one product should carry
# three base plans — "monthly", "semiannual", "annual" (fixed ids, see
# scripts/seed-app-subscription-package.mjs) — for the monthly/6-month/yearly
# prices. Only read by that seed script at seed time (to stamp the billing
# option records) — not read at runtime, so changing this after seeding
# requires re-running the script or editing the billing options directly.
GOOGLE_PLAY_SUBSCRIPTION_PRODUCT_ID=
#
# GOOGLE_PLAY_RTDN_TOKEN — shared secret appended as ?token=... to the RTDN
# (Real-time Developer Notifications) Pub/Sub push endpoint URL you configure
# in both Google Cloud Pub/Sub and Play Console's Monetization setup. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# See lib/providers/google-play-rtdn.ts.
GOOGLE_PLAY_RTDN_TOKEN=
#
# GOOGLE_PLAY_IAP_ENABLED — the purchases KILL SWITCH. Must be exactly "true" for new purchases to be
# accepted; unset or anything else is OFF (the default). Gates the purchase-verify route and the purchase-context
# route only. Notifications, reconciliation and acknowledgement retry keep running with it off, so access can
# always be withdrawn after a refund or expiry. Do not set this on a deployment until the staging checklist in
# docs/google-play-server-contract-2026-10.md has been completed.
GOOGLE_PLAY_IAP_ENABLED=
#
# GOOGLE_PLAY_IAP_ENVIRONMENT — labels the deployment: exactly "test", "staging" or "production". Purchases stay
# OFF unless this is one of those three AND GOOGLE_PLAY_IAP_ENABLED is "true". Recorded so a runbook and an audit
# row can say which environment a purchase was verified against.
GOOGLE_PLAY_IAP_ENVIRONMENT=

# ── AI allowance (lib/ai-allowance.ts) ───────────────────────────────────────────────────────────────────
# A cost allowance in USD for AI use, per member, by what the member holds. The values are the owner's decision; none is defaulted.
#   AI_ALLOWANCE_TRIAL_USD          ONE total for the whole free trial (never renewed by cancelling, reinstalling, restoring or converting)
#   AI_ALLOWANCE_PAID_USD           per rolling 30 days on a paid store subscription; begins when the trial converts
#   AI_ALLOWANCE_COMPLIMENTARY_USD  per rolling 30 days for staff-granted complimentary access (not a trial, not paid)
#   AI_ALLOWANCE_FREE_USD           per rolling 30 days for a member with no digital plan (food scans, receipts, alternatives, check-ins). 0 shows a friendly
#                                   "part of the App Subscription" message instead of a spending error.
# SHARED POOLS (all users together, rolling 30 days; each is a cap on what the system will AUTHORISE, not a forecast or a calendar-month figure):
#   AI_TRIAL_POOL_USD               trial AND free-tier use across all accounts. A new trial is only offered while this can honour it (the billing catalog says so).
#   AI_PAID_POOL_USD                paid subscribers. Trial, free, complimentary and staff use can never consume its unused remainder: that remainder is kept out of
#                                   their reach inside the ceiling.
#   AI_COMPLIMENTARY_POOL_USD       complimentary access, counted on its own: it is a cost to the business even though nobody pays for it
#   AI_STAFF_USD                    ONE shared budget for the staff-run features (coach summary, reply draft, exercise content), all staff together
#   AI_APP_CEILING_USD              an EMERGENCY ceiling on ALL AI spending (members and staff). It must be at least AI_PAID_POOL_USD. Reaching it stops AI for
#                                   EVERYONE, paid subscribers included: it is a last resort, not a promise of uninterrupted paid access.
# 0 is valid and means none. If NONE are set nothing is enforced (development). If ANY is set, enforcement is on and anything whose value is missing is
# refused. No store purchase can be started until ALL NINE are set, the ceiling is at least the paid pool, AND the model below has a known price (a plan is never
# sold with undefined AI cost).
# ANTHROPIC_MODEL must be a model lib/ai-usage.ts has a price for (claude-opus-4-8, claude-sonnet-4-6, claude-sonnet-5, claude-sonnet-5-5); an unpriced model
# is refused while allowances are enforced. Unset means claude-opus-4-8.
AI_ALLOWANCE_FREE_USD=
AI_ALLOWANCE_TRIAL_USD=
AI_ALLOWANCE_PAID_USD=
AI_ALLOWANCE_COMPLIMENTARY_USD=
AI_TRIAL_POOL_USD=
AI_PAID_POOL_USD=
AI_COMPLIMENTARY_POOL_USD=
AI_STAFF_USD=
AI_APP_CEILING_USD=

# ── App Store (StoreKit 2) digital plan ──────────────────────────────────────────────────────────────────
# Everything below is OFF and EMPTY by default. Nothing here is a real value. See docs/digital-subscription-contract-2026-10.md.
#
# APP_STORE_IAP_ENABLED — the App Store purchases KILL SWITCH. Exactly "true" for NEW purchases to be accepted. It does not stop
# notifications or reconciliation, so access can still be withdrawn after a refund or expiry.
APP_STORE_IAP_ENABLED=
# APP_STORE_IAP_ENVIRONMENT — exactly "test", "staging" or "production". Purchases stay OFF unless this is one of those AND the switch is "true".
APP_STORE_IAP_ENVIRONMENT=
# APP_STORE_ACCEPT_SANDBOX — exactly "true" to accept SANDBOX transactions (App Review and TestFlight purchases are sandbox). Off by default. A sandbox
# purchase is stored with environment "sandbox", is never counted as revenue, and is read from Apple's sandbox host. Xcode and LocalTesting
# transactions are never accepted.
APP_STORE_ACCEPT_SANDBOX=
# APP_STORE_BUNDLE_ID — the iOS bundle identifier ("com.sandcperformancecoaching.app"). Payloads for any other app are ignored.
APP_STORE_BUNDLE_ID=
# APP_STORE_ISSUER_ID / APP_STORE_KEY_ID / APP_STORE_PRIVATE_KEY_BASE64 — the In-App Purchase key from App Store Connect (Users and Access,
# Integrations, In-App Purchase). The .p8 file contents, base64 encoded:
#   node -e "console.log(require('fs').readFileSync('SubscriptionKey_XXXX.p8').toString('base64'))"
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_PRIVATE_KEY_BASE64=
# APP_STORE_ROOT_CERTIFICATES_BASE64 — Apple's root certificate(s), PEM, base64 encoded, downloaded from Apple's PKI page
# (https://www.apple.com/certificateauthority/) and CHECKED against the fingerprint Apple publishes there. Every signed payload from Apple is
# verified against these; with none configured nothing is trusted (fail closed).
APP_STORE_ROOT_CERTIFICATES_BASE64=
# APP_STORE_PRODUCT_ID_MONTHLY / _SEMIANNUAL / _ANNUAL — read by scripts/seed-app-subscription-package.mjs only (not at runtime): the App Store
# Connect product id for each billing period. Never defaulted; set exactly what you created in App Store Connect.
APP_STORE_PRODUCT_ID_MONTHLY=
APP_STORE_PRODUCT_ID_SEMIANNUAL=
APP_STORE_PRODUCT_ID_ANNUAL=

# TRUSTED_PROXY_HOPS — how many trusted proxies sit in front of the app and append the
# address they saw to X-Forwarded-For (default 0). Used ONLY to identify a client for
# IP-based rate limiting (public signups). 0 trusts no forwarded header: every request
# then shares one site-wide bucket, so nothing a client sends can pick its own bucket.
# Set it (e.g. 1) only after verifying on the deployed host how many proxies append to
# X-Forwarded-For; too high a value would trust client-supplied entries. See lib/client-ip.ts.
TRUSTED_PROXY_HOPS=

# --- Search and analytics (public website only) ---------------------------
#
# SEARCH_INDEXING — set to "off" on any staging/test deployment: robots.txt
# then disallows everything. Leave unset in production.
SEARCH_INDEXING=
#
# GOOGLE_SITE_VERIFICATION — the content value of Search Console's
# "HTML tag" verification method (only the token, not the whole <meta> tag).
# Rendered at build time; not needed if you verify by DNS (recommended).
GOOGLE_SITE_VERIFICATION=
#
# Google Analytics 4 — OFF unless BOTH are set. NEXT_PUBLIC_ values are
# inlined at build time, so set them before building and rebuild to change
# them. Even when on, GA loads only after a visitor accepts the cookie banner
# (components/analytics/SiteAnalytics.tsx), and only on public pages.
# NEXT_PUBLIC_ANALYTICS_ENABLED=true
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_ANALYTICS_ENABLED=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
