# Used to HMAC-sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Revolut Merchant API (membership billing). Leave unset to keep billing in
# its honest "not configured" state — selecting a plan only records intent,
# no charge occurs. See docs/billing-revolut.md for full setup steps.
REVOLUT_SECRET_KEY=
REVOLUT_WEBHOOK_SIGNING_SECRET=
REVOLUT_ENV=sandbox
REVOLUT_API_VERSION=2024-09-01
REVOLUT_CURRENCY=EUR

# How many hours before a class starts a cancellation still restores the
# member's session credit. Defaults to 12 if unset.
CANCELLATION_CUTOFF_HOURS=12

# Authorizes external schedulers to trigger background housekeeping jobs at
# POST/GET /api/cron/run (sent as `Authorization: Bearer <value>`). Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset locally — staff can still trigger a run manually from the
# Staff Operations page using their own session. See docs/scheduler.md.
CRON_SECRET=

# Web Push (VAPID). Generate a key pair once with:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY and NEXT_PUBLIC_VAPID_PUBLIC_KEY must be the same value.
# The NEXT_PUBLIC_ prefix exposes the key to client-side code (Phase 3 subscribe flow).
# Leave all three unset locally — push will fall back to console.log.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
#
# PUSH_ENABLED — operational kill-switch for all push sends. Set to "false" to
# suppress every sendPush() call without removing VAPID keys or redeploying.
# Omit or set to any other value to leave push enabled (subject to VAPID config).
# PUSH_ENABLED=false

# Outbound email via Resend (https://resend.com). Leave unset locally — email
# falls back to console.log so all other flows work without an API key.
#
# Production setup:
#   1. Add and verify your domain in the Resend dashboard (adds SPF/DKIM DNS records).
#   2. Create a production API key scoped to "Sending access".
#   3. Set EMAIL_FROM to a verified sender using the display-name format below.
#   4. Set APP_URL to your public domain so email action links resolve correctly.
#
# RESEND_API_KEY — leave blank locally (enables console fallback).
RESEND_API_KEY=
#
# EMAIL_FROM — sandbox address below works for local dev with Resend's shared domain.
# In production replace with a verified sender: "IronFlow <noreply@yourdomain.com>"
# Using onboarding@resend.dev in production will be rejected by the Resend API.
EMAIL_FROM=onboarding@resend.dev
#
# APP_URL — base URL used in email action links. Must be set in production.
# If unset in production, links silently fall back to http://localhost:3000.
APP_URL=http://localhost:3000

# Stripe (primary payment provider). In production use LIVE keys from a
# separate Stripe workspace/dashboard mode — never reuse test keys.
STRIPE_SECRET_KEY=
# Signing secret of the PRODUCTION webhook endpoint (whsec_...), created in
# the Stripe dashboard — the CLI listener secret is local-only.
STRIPE_WEBHOOK_SECRET=
# STRIPE_CURRENCY=eur
#
# APP_BASE_URL — base for Stripe checkout success/cancel redirects. MUST be
# set to the public domain in production or members return to localhost
# after paying.
APP_BASE_URL=http://localhost:3000

# AI coach (Workout Helper / coach summaries). Rotate before launch if the
# development key may have been exposed. Leave unset to disable AI features.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
